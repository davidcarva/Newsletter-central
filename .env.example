# Renomeie este arquivo para .env e preencha com sua chave REAL
# NUNCA commite o arquivo .env de verdade no Git
OPENAI_API_KEY=cole-sua-chave-aqui
OPENAI_MODEL=gpt-4o-mini

# Horário de geração da newsletter (formato HH:MM, 24h)
DAILY_TIME=12:00

# Fuso horário (padrão Brasil)
TIMEZONE=America/Sao_Paulo
