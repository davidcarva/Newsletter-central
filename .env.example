# Renomeie este arquivo para .env e preencha com sua chave REAL
# NUNCA commite o arquivo .env de verdade no Git
OPENAI_API_KEY=cole-sua-chave-aqui
OPENAI_MODEL=gpt-4o-mini

# Horário de geração da newsletter (formato HH:MM, 24h)
DAILY_TIME=12:00

# Fuso horário (padrão Brasil)
TIMEZONE=America/Sao_Paulo

# ---- Ponte com o Diretor (app de cenas) ----
# ID de usuário: veja em Configurações → Conta (nuvem) no Diretor
DIRETOR_UID=
# Arquivo .json da conta de serviço do Firebase (Configurações do projeto →
# Contas de serviço → Gerar nova chave privada). Guarde FORA do Git.
DIRETOR_CREDENCIAL=
# Endpoint que decupa o roteiro em cenas (só troque se mudar o domínio)
DIRETOR_API=https://directors-app-scenes.vercel.app/api/gerar-roteiro.js
